# Copy to deploy/.env on the server. Never commit the real file.
SITE_URL=https://karobarerp.ahmershah.dev
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=karobarerp.ahmershah.dev
DJANGO_ADMIN_URL=
DATABASE_URL=mysql://karobar:CHANGE_ME@mysql:3306/karobar
MYSQL_DATABASE=karobar
MYSQL_USER=karobar
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
NUM_PROXIES=1

# Email through Resend (required in production, or set EMAIL_BACKEND and EMAIL_* instead).
# The from address must be on a domain verified in Resend, for example a karobarerp subdomain.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Karobar ERP <no-reply@karobarerp.ahmershah.dev>

# reCAPTCHA v3 and v2 keys (required in production) with karobarerp.ahmershah.dev listed.
RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=
RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=
RECAPTCHA_V3_MIN_SCORE=0.5

# Optional social sign-in. Redirect URIs to register with each provider:
#   https://karobarerp.ahmershah.dev/api/accounts/oauth/google/callback/
#   https://karobarerp.ahmershah.dev/api/accounts/oauth/facebook/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
