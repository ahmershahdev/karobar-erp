# Copy to .env for local development. Never commit the real file.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/
SITE_URL=http://localhost:5173
DATABASE_URL=mysql://karobar:karobar@127.0.0.1:3306/karobar
REDIS_URL=redis://127.0.0.1:6379/0
NUM_PROXIES=0

# Email. Leave RESEND_API_KEY empty and mail is printed in the Django console instead.
# Resend: create a key at resend.com/api-keys with "Sending access", and verify the domain
# DEFAULT_FROM_EMAIL uses (resend.com/domains) or Resend will refuse to send.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Karobar ERP <no-reply@localhost>

# Google reCAPTCHA (google.com/recaptcha/admin). Register two keys: one "Score based (v3)" and
# one "Challenge (v2), I'm not a robot checkbox", both with localhost and your domain listed.
# Empty keys turn the check off; the honeypot still runs.
RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=
RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=
RECAPTCHA_V3_MIN_SCORE=0.5

# Sign in with Google (console.cloud.google.com, APIs and services, Credentials, OAuth client
# ID, type "Web application"). Authorised redirect URI:
#   http://localhost:5173/api/accounts/oauth/google/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Sign in with Facebook (developers.facebook.com, create an app, add Facebook Login). Valid
# OAuth redirect URI:
#   http://localhost:5173/api/accounts/oauth/facebook/callback/
# Off at launch, even with an app id: see docs/security.md, "Sign in with Google and Facebook".
FACEBOOK_SIGN_IN=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Groq, for the AI chat. Without a key the chat stays switched off.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Signs chat messages. Keep it stable: a new key cannot verify older chats.
CHAT_SIGNING_KEY=
